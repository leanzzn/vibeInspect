# VibeInspect AI 설정 예시. 이 파일을 복사해 같은 폴더에 .env 를 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore에 들어 있어 Git에 올라가지 않습니다. 실제 키를 이 예시 파일에 적지 마세요.

# ChatKHU API Gateway 주소. 비워 두면 기본값(https://factchat-cloud.mindlogic.ai/v1/gateway)을 씁니다.
# 주의: 끝에 /claude 같은 경로를 붙이면 404가 납니다.
CHATKHU_BASE_URL=

# ChatKHU에서 발급받은 API 키 (서버에서만 사용되고 브라우저로 전달되지 않습니다)
CHATKHU_API_KEY=

# 사용할 텍스트 생성 모델의 정확한 ID (GET /models/ 결과의 id 값) 권장: gpt-6-luna (입력 $0.1·출력 $0.5 / 1M 토큰)
CHATKHU_MODEL=

# 1로 두면 실제 AI를 부르지 않고 모의 응답을 돌려줍니다(화면 시험용).
CHATKHU_MOCK=
