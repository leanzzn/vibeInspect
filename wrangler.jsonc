// npm run build 후 npx wrangler deploy. 키는 npx wrangler secret put CHATKHU_API_KEY 로 넣는다(이 파일에 적지 말 것).
{
  "name": "vibeinspect",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "CHATKHU_MODEL": "gemini-3.1-flash-lite" }
}
